{
  "name": "BoltaNote",
  "task": "Pakistani banknote recognition for blind and low-vision people",
  "classes": [
    "10_front",
    "10_back",
    "20_front",
    "20_back",
    "50_front",
    "50_back",
    "100_front",
    "100_back",
    "500_front",
    "500_back",
    "1000_front",
    "1000_back",
    "5000_front",
    "5000_back",
    "none"
  ],
  "values": [
    "10",
    "20",
    "50",
    "100",
    "500",
    "1000",
    "5000",
    "none"
  ],
  "class_to_value": {
    "10_front": "10",
    "10_back": "10",
    "20_front": "20",
    "20_back": "20",
    "50_front": "50",
    "50_back": "50",
    "100_front": "100",
    "100_back": "100",
    "500_front": "500",
    "500_back": "500",
    "1000_front": "1000",
    "1000_back": "1000",
    "5000_front": "5000",
    "5000_back": "5000",
    "none": "none"
  },
  "input": {
    "name": "image",
    "shape": [
      1,
      3,
      224,
      224
    ],
    "dtype": "float32",
    "range": [
      0,
      1
    ],
    "layout": "RGB, channels first",
    "preprocessing": "whole photo, EXIF-rotated upright, resized (squeezed) to 224x224 bilinear, divide by 255; normalisation is inside the model"
  },
  "outputs": {
    "probs": "softmax over the 15 classes, shape [1, 15]; add front + back for the note value"
  },
  "speaking": {
    "rule": "speak the top value if it is not 'none' and its probability >= threshold (the app also needs 3 frames in a row)",
    "threshold": 0.68,
    "threshold_chosen_on": "lowest threshold with <= 0.2% (1 in 500) wrong-value rate on 4 augmented passes of the validation set",
    "phrases": {
      "10": [
        "دس روپے",
        "Ten rupees"
      ],
      "20": [
        "بیس روپے",
        "Twenty rupees"
      ],
      "50": [
